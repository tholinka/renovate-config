{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"github>tholinka/renovate-config:automerge.json5",
		"github>tholinka/renovate-config:labels.json5",

		// handle postgres version upgrades in image name
		"github>home-operations/renovate-presets//apps/cnpg.json5#6.0.0",
		// handle various formats of grafana (operator) dashboards
		"github>home-operations/renovate-presets//apps/grafanaDashboards.json5#6.0.0",
		// properly handle searxng versioning scheme
		"github>home-operations/renovate-presets//apps/searxng.json5",
		// grab talos versions from talos factory instead
		"github>home-operations/renovate-presets//apps/talosFactory.json5#6.0.0",

		// handle j2 files
		"github>home-operations/renovate-presets//config/managerFilePatterns.json5#6.0.0",
		// mirror.gcr.io doesn't update metadata very often
		"github>home-operations/renovate-presets//config/registryAliases.json5#6.0.0",

		// handle annotated (e.g. # reno(BREAK)vate: datasource=github-releases depName=foo/bar))
		"github>home-operations/renovate-presets//managers/annotated.json5#6.0.0",
		// handle oci in e.g. flux or helm
		"github>home-operations/renovate-presets//managers/oci.json5#6.0.0",

		// common changelog locations
		"github>home-operations/renovate-presets//overrides/changelogs.json5#6.0.0",
		// make helmfile names nicer
		"github>home-operations/renovate-presets//overrides/helmfile.json5#6.0.0",
		// normalize mise dependency names
		"github>home-operations/renovate-presets//overrides/mise.json5#6.0.0",
		// common changelog locations
		"github>home-operations/renovate-presets//overrides/renovateOperator.json5#6.0.0",

		// setup renovate's semantic coommits
		"github>home-operations/renovate-presets//policies/semanticCommits.json5#6.0.0",
		// properly handle semver 0.x versions
		"github>home-operations/renovate-presets//policies/zer0ver.json5#6.0.0",
	]
}
